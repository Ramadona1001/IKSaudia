APP_NAME="IK Saudi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://iksaudi.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_STACK=daily,security

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iksaudi
DB_USERNAME=iksaudi
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@iksaudi.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_NOTIFY=info@iksaudi.com

SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_PRELOAD=false

ADMIN_IP_ALLOWLIST_ENABLED=false
ADMIN_IP_ALLOWLIST=

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ADMIN_2FA_ENABLED=false
ADMIN_2FA_REQUIRED=false

TRUSTED_PROXIES=*

RATE_LIMIT_CONTACT=5
RATE_LIMIT_CONTACT_HOUR=20
RATE_LIMIT_ADMIN_LOGIN=5

UPLOAD_STRIP_EXIF=true
UPLOAD_VIRUS_SCAN_ENABLED=false

HTTP_ALLOWED_HOSTS=www.iksaudi.com,iksaudi.com
