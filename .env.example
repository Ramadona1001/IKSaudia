APP_NAME="IK Saudi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: APP_ENV=production APP_DEBUG=false
APP_TIMEZONE=UTC
# Must match how you open the site (host + port). Mismatch causes CORS on Filament file previews.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production: SESSION_ENCRYPT=true SESSION_SECURE_COOKIE=true SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production: CACHE_STORE=redis SESSION_DRIVER=redis QUEUE_CONNECTION=redis
CACHE_PREFIX=

# Security (see config/security.php)
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=true
# SECURITY_CSP_REPORT_URI=https://your-csp-reporter.example/report
SECURITY_HSTS_ENABLED=true
TRUSTED_PROXIES=*
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CONTACT_HOUR=20
RATE_LIMIT_ADMIN_LOGIN=5
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_DECAY_MINUTES=15
SECURITY_PASSWORD_MIN_LENGTH=12
CONTACT_MIN_SUBMIT_SECONDS=3

ADMIN_IP_ALLOWLIST_ENABLED=false
ADMIN_IP_ALLOWLIST=

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ADMIN_2FA_ENABLED=false
ADMIN_2FA_REQUIRED=false

UPLOAD_STRIP_EXIF=true
UPLOAD_VIRUS_SCAN_ENABLED=false
HTTP_ALLOWED_HOSTS=www.iksaudi.com,iksaudi.com

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_NOTIFY=info@iksaudi.com

LOG_SECURITY_DAYS=90

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
